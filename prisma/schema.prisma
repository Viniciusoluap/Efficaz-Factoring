generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Perfil {
  ADMIN
  OPERADOR
  CLIENTE
  FORNECEDOR
}

enum TituloTipo {
  CHEQUE
  BOLETO
  PROMISSORIA
}

enum TituloStatus {
  PENDENTE
  APROVADO
  VENCIDO
  LIQUIDADO
  PROTESTADO
  CANCELADO
}

enum ContratoStatus {
  AGUARDANDO_ASSINATURA
  ASSINADO
  EXPIRADO
}

enum ComunicacaoTipo {
  EMAIL
  WHATSAPP
}

enum ComunicacaoGatilho {
  D_MENOS_3
  D_MENOS_1
  D_0
  D_MAIS_1
  D_MAIS_3
  D_MAIS_5
}

model Usuario {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  senha     String
  perfil    Perfil   @default(OPERADOR)
  ativo     Boolean  @default(true)
  fotoUrl   String?
  criadoEm  DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  cliente    Cliente?
  fornecedor Fornecedor?

  @@map("usuarios")
}

model Cliente {
  id        String   @id @default(cuid())
  usuarioId String   @unique
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  nome      String
  cpfCnpj   String   @unique
  email     String
  telefone          String?
  endereco          String?
  representanteNome String?
  representanteCpf  String?
  ativo             Boolean  @default(true)
  criadoEm          DateTime @default(now())
  atualizadoEm      DateTime @updatedAt

  titulos       Titulo[]
  operacoes     Operacao[]
  solicitacoes  SolicitacaoCliente[]

  @@map("clientes")
}

model SolicitacaoCliente {
  id              String   @id @default(cuid())
  clienteId       String
  cliente         Cliente  @relation(fields: [clienteId], references: [id])
  tipo            String
  descricao       String   @db.Text
  valorEstimado   Decimal? @db.Decimal(15, 2)
  status          String   @default("AGUARDANDO")
  observacaoAdmin String?  @db.Text
  anexos          String[]
  criadoEm       DateTime @default(now())
  atualizadoEm   DateTime @updatedAt

  @@map("solicitacoes_cliente")
}

model Fornecedor {
  id           String   @id @default(cuid())
  usuarioId    String   @unique
  usuario      Usuario  @relation(fields: [usuarioId], references: [id])
  nome         String
  cpfCnpj      String   @unique
  email        String
  telefone     String?
  capitalTotal Decimal  @default(0) @db.Decimal(15, 2)
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  titulos    Titulo[]
  operacoes  Operacao[]

  @@map("fornecedores")
}

model Titulo {
  id                  String       @id @default(cuid())
  tipo                TituloTipo
  numero              String
  emitenteCpfCnpj     String
  emitenteNome        String
  sacadoCpfCnpj       String
  sacadoNome          String
  dataEmissao         DateTime
  dataVencimento      DateTime
  prazo               Int
  valor               Decimal      @db.Decimal(15, 2)
  taxaCliente         Decimal      @db.Decimal(8, 4)
  taxaFornecedor      Decimal      @db.Decimal(8, 4)
  encargo             Decimal      @db.Decimal(15, 2)
  valorLiquidoCliente Decimal      @db.Decimal(15, 2)
  custoCedente        Decimal      @db.Decimal(15, 2)
  spreadBruto         Decimal      @db.Decimal(15, 2)
  taxaEspelho         Decimal?     @db.Decimal(8, 4)
  baseEspelho         Decimal?     @db.Decimal(15, 2)
  impostoProvisao     Decimal?     @db.Decimal(15, 2)
  spreadLiquido       Decimal?     @db.Decimal(15, 2)
  garantiaUrl         String?
  clienteId           String?
  cliente             Cliente?     @relation(fields: [clienteId], references: [id])
  fornecedorId        String?
  fornecedor          Fornecedor?  @relation(fields: [fornecedorId], references: [id])
  operacaoId          String?
  operacao            Operacao?    @relation(fields: [operacaoId], references: [id])
  status              TituloStatus @default(PENDENTE)
  observacoes         String?
  criadoEm            DateTime     @default(now())
  atualizadoEm        DateTime     @updatedAt

  contrato     Contrato?
  comunicacoes Comunicacao[]

  @@map("titulos")
}

model Operacao {
  id             String      @id @default(cuid())
  numero         String      @unique
  taxaCliente    Decimal     @db.Decimal(8, 4)
  taxaFornecedor Decimal     @db.Decimal(8, 4)
  clienteId      String?
  cliente        Cliente?    @relation(fields: [clienteId], references: [id])
  fornecedorId   String?
  fornecedor     Fornecedor? @relation(fields: [fornecedorId], references: [id])
  observacoes    String?
  status         String      @default("ABERTA")
  criadoEm      DateTime    @default(now())
  atualizadoEm  DateTime    @updatedAt

  titulos Titulo[]

  @@map("operacoes")
}

model Contrato {
  id              String         @id @default(cuid())
  tituloId        String         @unique
  titulo          Titulo         @relation(fields: [tituloId], references: [id])
  conteudo        String         @db.Text
  status          ContratoStatus @default(AGUARDANDO_ASSINATURA)
  assinadoEm      DateTime?
  signatarioEmail String?
  criadoEm        DateTime       @default(now())
  atualizadoEm    DateTime       @updatedAt

  @@map("contratos")
}

model Comunicacao {
  id        String             @id @default(cuid())
  tituloId  String
  titulo    Titulo             @relation(fields: [tituloId], references: [id])
  tipo      ComunicacaoTipo
  gatilho   ComunicacaoGatilho
  enviadoEm DateTime?
  status    String             @default("PENDENTE")
  erro      String?
  criadoEm  DateTime           @default(now())

  @@map("comunicacoes")
}

model Solicitacao {
  id        String   @id @default(cuid())
  nome      String
  empresa   String
  email     String
  telefone  String
  porte     String?
  servico   String?
  mensagem  String?  @db.Text
  lida      Boolean  @default(false)
  criadoEm  DateTime @default(now())

  @@map("solicitacoes")
}

model Configuracao {
  id               String   @id @default("default")
  taxaMinimaFiscal Decimal  @default(0.5)  @db.Decimal(8, 4)
  aliquotaImposto  Decimal  @default(35)   @db.Decimal(5, 2)
  aliquotaPIS      Decimal  @default(1.65) @db.Decimal(5, 2)
  aliquotaCOFINS   Decimal  @default(7.6)  @db.Decimal(5, 2)
  aliquotaIRPJ     Decimal  @default(15)   @db.Decimal(5, 2)
  aliquotaCSLL     Decimal  @default(9)    @db.Decimal(5, 2)
  aliquotaISS      Decimal  @default(5)    @db.Decimal(5, 2)
  aliquotaIOF      Decimal  @default(0.38) @db.Decimal(5, 2)
  nomeEmpresa      String   @default("Efficaz Factoring")
  cnpj             String?
  emailSistema     String?
  telefone         String?
  endereco         String?
  whatsappApiKey   String?
  atualizadoEm     DateTime @updatedAt

  @@map("configuracoes")
}
