# =============================================
# Configurações de E-mail — Efficaz Factoring
# =============================================
# Copie este arquivo para .env.local e preencha
# com as credenciais do seu servidor de e-mail.

# Servidor SMTP (fornecido pela hospedagem do domínio)
SMTP_HOST=mail.grupoefficaz.com.br
SMTP_PORT=587
# Use "true" somente se a porta for 465 (SSL)
SMTP_SECURE=false

# Credenciais da conta de e-mail remetente
SMTP_USER=contato@grupoefficaz.com.br
SMTP_PASS=sua_senha_aqui
