# ================================================
# Efficaz Factoring ERP — Variáveis de Ambiente
# ================================================
# Copie este arquivo para .env.local e preencha.

# ----------------------------
# Banco de Dados PostgreSQL
# ----------------------------
# Use Neon (neon.tech) ou Supabase (supabase.com) — ambos gratuitos
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# ----------------------------
# Autenticação (NextAuth)
# ----------------------------
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET="sua_chave_secreta_aqui"
NEXTAUTH_URL="http://localhost:3000"

# ----------------------------
# E-mail SMTP
# ----------------------------
SMTP_HOST=mail.grupoefficaz.com.br
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=contato@grupoefficaz.com.br
SMTP_PASS=sua_senha_aqui

# ----------------------------
# WhatsApp — Z-API (zapi.io)
# ----------------------------
# Crie conta em zapi.io, conecte seu WhatsApp e copie os valores abaixo
ZAPI_INSTANCE_ID=seu_instance_id
ZAPI_TOKEN=seu_token
ZAPI_CLIENT_TOKEN=seu_client_token
